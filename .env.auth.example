# 仅供 cloud-functions 或 npm run dev:auth 使用，不能以 VITE_ 开头，也不要提交真实值。
AUTH_PORT=8787
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 可选，留空时使用 AppSecret 作为 state 签名密钥。
WECHAT_STATE_SECRET=
WECHAT_ALLOWED_ORIGINS=http://127.0.0.1:5173,https://barone.chat
WECHAT_ALLOWED_REDIRECT_URIS=http://127.0.0.1:5173/,https://barone.chat/
